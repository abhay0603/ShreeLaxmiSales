<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHREE LAXMI SALES"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Billing"
                    android:textColor="#8E9AAF"
                    android:textSize="13sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/invoicePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OCT 01"
                android:textColor="#62A8FF"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- TOTAL CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#151D30">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT TOTAL"
                android:textColor="#8793A8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/totalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹0"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/finalTotalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="FINAL TOTAL"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2377E8"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ITEM NAME -->

        <EditText
            android:id="@+id/itemName"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:hint="Item name  •  optional"
            android:textColor="#FFFFFF"
            android:textColorHint="#667085"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="#151D30"/>


        <!-- QUANTITY + RATE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/quantity"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:hint="Quantity"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#667085"
                android:textSize="17sp"
                android:padding="14dp"
                android:background="#151D30"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <EditText
                android:id="@+id/rate"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1"
                android:hint="Rate ₹"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#667085"
                android:textSize="17sp"
                android:padding="14dp"
                android:background="#151D30"/>

        </LinearLayout>


        <!-- ITEM TOTAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#10182A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ITEM TOTAL"
                android:textColor="#8793A8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/itemTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#53B7FF"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ITEMS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ITEMS"
            android:textColor="#8793A8"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/itemList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"/>


        <!-- CALCULATOR -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CALCULATOR"
            android:textColor="#8793A8"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/calculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <!-- ROW 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="C"/>

                <Button
                    android:id="@+id/percentButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="%"/>

                <Button
                    android:id="@+id/divideButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="÷"/>

                <Button
                    android:id="@+id/backspaceButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⌫"/>

            </LinearLayout>

            <!-- ROW 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <Button
                    android:id="@+id/sevenButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="7"/>

                <Button
                    android:id="@+id/eightButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="8"/>

                <Button
                    android:id="@+id/nineButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="9"/>

                <Button
                    android:id="@+id/multiplyButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="×"/>

            </LinearLayout>

            <!-- ROW 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <Button
                    android:id="@+id/fourButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="4"/>

                <Button
                    android:id="@+id/fiveButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="5"/>

                <Button
                    android:id="@+id/sixButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="6"/>

                <Button
                    android:id="@+id/minusButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="−"/>

            </LinearLayout>

            <!-- ROW 4 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <Button
                    android:id="@+id/oneButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="1"/>

                <Button
                    android:id="@+id/twoButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="2"/>

                <Button
                    android:id="@+id/threeButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="3"/>

                <Button
                    android:id="@+id/plusButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="+"/>

            </LinearLayout>

            <!-- ROW 5 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <Button
                    android:id="@+id/signButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="+/−"/>

                <Button
                    android:id="@+id/zeroButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="0"/>

                <Button
                    android:id="@+id/doubleZeroButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="00"/>

                <Button
                    android:id="@+id/equalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="="/>

            </LinearLayout>

        </LinearLayout>


        <!-- NEXT ITEM -->

        <Button
            android:id="@+id/nextItemButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="＋  NEXT ITEM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1B273D"/>


        <!-- GENERATE BILL -->

        <Button
            android:id="@+id/generateBillButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="GENERATE BILL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#D49A32"/>

    </LinearLayout>

</ScrollView>
