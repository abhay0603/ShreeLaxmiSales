<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sls_background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHREE LAXMI SALES"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAST BILLING"
                android:textColor="@color/sls_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/invoicePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_secondary_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="OCT 01"
            android:textColor="@color/sls_gold_light"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ITEM NAME -->
    <EditText
        android:id="@+id/itemName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input"
        android:hint="Item name (optional)"
        android:inputType="textCapSentences"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/sls_white"
        android:textColorHint="@color/sls_text_secondary"
        android:textSize="14sp" />

    <!-- QUANTITY / X / RATE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- QUANTITY -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUANTITY"
                android:textColor="@color/sls_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/quantity"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:text="0"
                android:textColor="@color/sls_white"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- LARGE X -->
        <Button
            android:id="@+id/btnMultiply"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_calculator_multiply"
            android:text="×"
            android:textColor="@color/sls_white"
            android:textSize="29sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- RATE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RATE"
                android:textColor="@color/sls_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/rate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:text="0"
                android:textColor="@color/sls_white"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- STATUS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/itemCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 items added"
            android:textColor="@color/sls_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/lastItemText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/sls_gold_light"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CALCULATOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_operator"
                android:text="C"
                android:textColor="@color/sls_danger"
                android:textSize="18sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btnPercent"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_operator"
                android:text="%"
                android:textColor="@color/sls_white"
                android:textSize="18sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btnDivide"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_operator"
                android:text="÷"
                android:textColor="@color/sls_white"
                android:textSize="21sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btnBackspace"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_operator"
                android:text="⌫"
                android:textColor="@color/sls_white"
                android:textSize="19sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_number"
                android:text="7"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn8"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_number"
                android:text="8"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn9"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_number"
                android:text="9"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btnMinus"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_operator"
                android:text="−"
                android:textColor="@color/sls_white"
                android:textSize="23sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_number"
                android:text="4"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn5"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_number"
                android:text="5"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btn6"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_number"
                android:text="6"
                android:textColor="@color/sls_white"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/btnPlus"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_operator"
                android:text="+"
                android:textColor="@color/sls_white"
                android:textSize="23sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

        <!-- ROW 4 + LARGE NEXT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <!-- LEFT 3-COLUMN CALCULATOR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <!-- 1 2 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn1"
                        style="@android:style/Widget.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_calculator_number"
                        android:text="1"
                        android:textColor="@color/sls_white"
                        android:textSize="20sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/btn2"
                        style="@android:style/Widget.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_calculator_number"
                        android:text="2"
                        android:textColor="@color/sls_white"
                        android:textSize="20sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/btn3"
                        style="@android:style/Widget.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_calculator_number"
                        android:text="3"
                        android:textColor="@color/sls_white"
                        android:textSize="20sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                </LinearLayout>

                <!-- +/− 0 00 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSign"
                        style="@android:style/Widget.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_calculator_operator"
                        android:text="+/−"
                        android:textColor="@color/sls_white"
                        android:textSize="15sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/btn0"
                        style="@android:style/Widget.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_calculator_number"
                        android:text="0"
                        android:textColor="@color/sls_white"
                        android:textSize="20sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/btn00"
                        style="@android:style/Widget.Button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_calculator_number"
                        android:text="00"
                        android:textColor="@color/sls_white"
                        android:textSize="17sp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                </LinearLayout>

                <!-- DECIMAL -->
                <Button
                    android:id="@+id/btnDecimal"
                    style="@android:style/Widget.Button"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.7"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_calculator_number"
                    android:text="."
                    android:textColor="@color/sls_white"
                    android:textSize="22sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <!-- LARGE NEXT ITEM -->
            <Button
                android:id="@+id/btnNextItem"
                style="@android:style/Widget.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_calculator_next"
                android:text="⊕&#10;NEXT&#10;ITEM"
                android:textColor="@color/sls_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- FIXED BOTTOM TOTAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/sls_surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="@color/sls_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="@color/sls_white"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnFinalTotal"
            style="@android:style/Widget.Button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_secondary_button"
            android:text="VIEW BILL"
            android:textColor="@color/sls_gold_light"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btnGenerateBill"
            style="@android:style/Widget.Button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_primary_button"
            android:text="GENERATE BILL"
            android:textColor="@color/sls_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

</LinearLayout>
